# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Telegram — create a bot with @BotFather; chat id = the owner's chat with the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TikTok — https://developers.tiktok.com (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://USER.github.io/REPO/callback.html
TIKTOK_REFRESH_TOKEN=
TIKTOK_POST_MODE=DIRECT_POST        # or MEDIA_UPLOAD (goes to his TikTok drafts/inbox)
TIKTOK_PRIVACY=SELF_ONLY            # PUBLIC_TO_EVERYONE after TikTok approves the app

# Public URL of the docs/ folder (GitHub Pages), verified in the TikTok developer portal
PUBLIC_BASE_URL=https://USER.github.io/REPO
